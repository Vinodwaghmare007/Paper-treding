  },
  "signInInviteCodeLabel": "Referral or invite code (optional)",
  "@signInInviteCodeLabel": {
    "description": "Optional text field on the sign-up form where a new user can paste either a consumer referral code (from a friend) or a B2B academy invite code (from their instructor) — the app tries both server-side, the field doesn't ask which kind it is."
  },

  "signInInviteCodeAppliedOrg": "Invite code applied — you've joined your academy.",
