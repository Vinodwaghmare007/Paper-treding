{
  "@@locale": "en",

  "appTitle": "Crypto Paper Trader",
  "@appTitle": {
    "description": "The app's name, shown on the sign-in screen and as the OS app title. Proper noun — do not localize, transliterate to the target script only if that's how the app would realistically be marketed there; otherwise keep in Latin script."
  },

  "disclaimerEducationalSimulator": "Educational simulator — no real funds involved.",
  "@disclaimerEducationalSimulator": {
    "description": "Subtitle directly under the app name on the sign-in screen — the very first thing any new user reads. LEGAL/COMPLIANCE TEXT: must be reviewed by a native speaker before this locale ships publicly; never approximate this meaning.",
    "disclaimer": true
  },

  "disclaimerSimulatedFooter": "SIMULATED — Educational only, no real money",
  "@disclaimerSimulatedFooter": {
    "description": "Persistent one-line footer shown at the bottom of every signed-in screen (chart, portfolio, orders, news). LEGAL/COMPLIANCE TEXT: must be reviewed by a native speaker before this locale ships publicly. Keep it short — this renders in a single line at font size 10.",
    "disclaimer": true
  },

  "disclaimerNotFinancialAdvice": "Educational only — not financial advice.",
  "@disclaimerNotFinancialAdvice": {
    "description": "Short disclaimer reused across share cards and results screens (What-If Time Machine, DCA Simulator, backtester). LEGAL/COMPLIANCE TEXT: must be reviewed by a native speaker before this locale ships publicly.",
    "disclaimer": true
  },

  "chooseLanguageTitle": "Choose your language",
  "@chooseLanguageTitle": {
    "description": "Heading on the first-run language picker, shown once before sign-in, and reused as a section heading in Settings. Keep this string itself in English in every ARB file except ideally it should read naturally to someone who hasn't picked a language yet — many apps show this line in the *target* language on each row instead of translating this heading; see languagePickerRowLabel."
  },

  "chooseLanguageSubtitle": "You can change this anytime in Settings.",
  "@chooseLanguageSubtitle": {
    "description": "Small helper text under the first-run language picker's heading, reassuring the user this choice isn't permanent."
  },

  "continueButton": "Continue",
  "@continueButton": {
    "description": "Button that confirms the chosen language and proceeds to sign-in, on the first-run language picker screen."
  },

  "settingsTitle": "Settings",
  "@settingsTitle": {
    "description": "App bar title on the Settings screen."
  },

  "settingsLanguageSectionTitle": "Language",
  "@settingsLanguageSectionTitle": {
    "description": "Section heading in Settings above the language picker (same picker as the first-run onboarding step)."
  },

  "settingsCurrencySectionTitle": "Display currency",
  "@settingsCurrencySectionTitle": {
    "description": "Section heading in Settings for the USD/INR display-currency toggle."
  },

  "settingsCurrencyDescription": "Applies to every price shown in the app — the chart, portfolio, orders, and Markets screen. Trades are always recorded in USD underneath; this only changes the display.",
  "@settingsCurrencyDescription": {
    "description": "Explanatory text under the currency section heading in Settings, clarifying that only the display changes, not the underlying stored values."
  },

  "settingsCurrencyUsdLabel": "USD ($)",
  "@settingsCurrencyUsdLabel": {
    "description": "Label on the USD option of the currency toggle in Settings. The $ symbol itself is not translated."
  },

  "settingsCurrencyInrLabel": "INR (₹)",
  "@settingsCurrencyInrLabel": {
    "description": "Label on the INR option of the currency toggle in Settings. The ₹ symbol itself is not translated."
  },

  "settingsExchangeRateLine": "1 USD ≈ {rate}",
  "@settingsExchangeRateLine": {
    "description": "Shows the current USD-to-INR exchange rate below the currency toggle, only visible when INR is selected. {rate} is a pre-formatted currency string (e.g. '₹84.12') built with intl's NumberFormat, not a raw number — do not add another currency symbol around it.",
    "placeholders": {
      "rate": {
        "type": "String",
        "example": "₹84.12"
      }
    }
  },

  "settingsExchangeRateStale": " (last known rate — refresh failed)",
  "@settingsExchangeRateStale": {
    "description": "Appended after settingsExchangeRateLine when the rate is a stale cached value because the latest fetch failed. Note the leading space — it's concatenated directly onto the rate line, not shown as a separate sentence."
  },

  "settingsExchangeRateLoading": "Loading exchange rate…",
  "@settingsExchangeRateLoading": {
    "description": "Shown below the currency toggle while the first USD-to-INR rate fetch is still in flight."
  },

  "settingsExchangeRateError": "Could not load an exchange rate yet — showing USD until it does.",
  "@settingsExchangeRateError": {
    "description": "Shown below the currency toggle if the USD-to-INR rate has never successfully loaded (no cached fallback available either)."
  },

  "settingsReportTranslationIssue": "Report a translation issue",
  "@settingsReportTranslationIssue": {
    "description": "Settings menu entry that opens a form to report a mistranslated or awkward string, for languages the developer can't read (Tamil/Telugu/Kannada) to be corrected by community feedback."
  },

