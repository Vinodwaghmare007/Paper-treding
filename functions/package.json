{
  "name": "crypto-paper-trader-functions",
  "description": "Cloud Functions for Crypto Paper Trader: chat moderation, community sentiment, daily puzzle, market weather, cohort medians.",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:chat-rooms": "ts-node src/scripts/seedChatRooms.ts",
    "test": "npm run build && node --test lib/**/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-test \"ts-node test/firestoreRules.test.ts\"",
    "test:delete-account": "firebase emulators:exec --only firestore,auth --project demo-test \"ts-node test/deleteAccount.test.ts\"",
    "test:certifications": "firebase emulators:exec --only firestore --project demo-test \"ts-node test/certifications.test.ts\"",
    "test:trader-stats": "ts-node test/traderStats.test.ts",
    "test:leaderboard": "ts-node test/computeLeaderboard.test.ts",
    "test:trade-rationale": "firebase emulators:exec --only firestore --project demo-test \"ts-node test/addTradeRationale.test.ts\"",
    "test:trader-profile": "firebase emulators:exec --only firestore --project demo-test \"ts-node test/traderProfile.test.ts\"",
    "test:price-alerts": "ts-node test/checkPriceAlerts.test.ts",
    "test:conditional-orders": "ts-node test/executeConditionalOrder.test.ts",
    "test:news": "ts-node test/news.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^20.17.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "private": true
}
