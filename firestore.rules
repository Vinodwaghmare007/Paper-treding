rules_version = '2';

// ============================================================================
// Trading (Phase 2): users/{userId}, .../portfolio/{coinSymbol}, .../orders/{orderId}
// Community + engagement (Phase 5): chat_rooms, chat_rate_limits, reports,
//   daily_puzzle, public_sentiment, public_market_weather, public_cohort_medians
// Certifications (Phase 7): .../certifications/{certId}, public_certifications
// Trader Profiles (Phase 8): .../profile_settings, .../profile_stats,
//   .../public_activity, .../following, .../orders/{id}/rationale,
//   public_leaderboard
// Growth phase: organizations/{orgId} (+ members, aggregate_stats),
//   org_invite_codes, referral_codes, referrals
// News feed (provider-based aggregation): news_items, news_pipeline_status
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Cached by functions/src/chat/updateSkillLevelOnOrder.ts, never
    // client-writable (see isValidAccountUpdate below) — this is what lets
    // rules gate chat reads by skill level with a plain get(), since rules
    // can't run the count() query that actually computes skill level.
    function callerSkillLevel() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.get('skill_level', 'beginner');
    }

    // Phase 8 (Trader Profiles): the single source of truth rules trust
    // for "does this user's public profile exist and is it visible to
    // strangers." Reads profile_settings rather than profile_stats
    // because profile_settings is the doc the owner actually writes —
    // functions/src/traderProfile/syncProfileVisibility.ts mirrors this
    // same value onto profile_stats immediately on every write so
    // Cloud Functions (compute_leaderboard.ts) never need this get().
    function isProfilePublic(userId) {
      let settingsDoc = get(/databases/$(database)/documents/users/$(userId)/profile_settings/data);
      return settingsDoc.data.get('is_public', false) == true;
    }

    // ------------------------------------------------------------------
    // Trading (unchanged from Phase 2, plus Phase 5 field additions)
    // ------------------------------------------------------------------

    function isValidAccountUpdate() {
      let data = request.resource.data;
      return data.virtual_balance is number
        && data.consecutive_losses is int
        && data.consecutive_losses >= 0
        && (data.buy_locked_until == null || data.buy_locked_until is timestamp)
        // skill_level is written only by updateSkillLevelOnOrder.ts and
        // puzzle_streak/puzzle_last_played_date/puzzle_last_played_at only
        // by submitPuzzleAnswer.ts — both Admin SDK, both bypass rules
        // entirely. This just stops a *client* write from forging any of
        // them; comparing against the pre-write value (rather than banning
        // the field outright) lets an update that doesn't touch a field
        // pass through without clobbering what a Cloud Function set.
        && request.resource.data.get('skill_level', null) == resource.data.get('skill_level', null)
        && request.resource.data.get('puzzle_streak', null) == resource.data.get('puzzle_streak', null)
        && request.resource.data.get('puzzle_last_played_date', null) == resource.data.get('puzzle_last_played_date', null)
        && request.resource.data.get('puzzle_last_played_at', null) == resource.data.get('puzzle_last_played_at', null)
        // backtest_run_count is only ever incremented by
        // recordBacktestCompletion.ts (Admin SDK, bypasses rules) — same
        // forgery guard as the skill_level/puzzle fields above, so a
        // client can't fake its way toward the backtester_master cert.
        && request.resource.data.get('backtest_run_count', null) == resource.data.get('backtest_run_count', null)
        // Growth phase (B2B org membership + referrals): org_id is only
        // ever set by redeemOrgInviteCode; referral_code only by
        // generateReferralCode; referred_by/pro_days_earned/
        // pro_access_until only by redeemReferralCode — all three
        // Cloud Functions, all Admin SDK, all bypass these rules. Same
        // forgery-guard shape as every field above: a client's update
        // can't touch any of these regardless of what else it changes.
        && request.resource.data.get('org_id', null) == resource.data.get('org_id', null)
        && request.resource.data.get('referral_code', null) == resource.data.get('referral_code', null)
        && request.resource.data.get('referred_by', null) == resource.data.get('referred_by', null)
        && request.resource.data.get('pro_days_earned', null) == resource.data.get('pro_days_earned', null)
        && request.resource.data.get('pro_access_until', null) == resource.data.get('pro_access_until', null);
    }

    function isValidPosition() {
      let data = request.resource.data;
      return data.total_quantity is number && data.total_quantity > 0
        && data.avg_buy_price is number && data.avg_buy_price >= 0;
    }

    function isValidOrder() {
      let data = request.resource.data;
      return data.coin_symbol is string
        && (data.order_type == 'BUY' || data.order_type == 'SELL')
        && data.price is number && data.price > 0
        && data.quantity is number && data.quantity > 0
        && data.timestamp is timestamp
        && (data.realized_pnl == null || data.realized_pnl is number);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Initial doc is created by AuthRepository at sign-up/first sign-in;
      // every later write comes from execute_trade's transaction (or a
      // Cloud Function, which bypasses rules).
      allow create: if isOwner(userId)
        && request.resource.data.virtual_balance == 100000
        && request.resource.data.starting_balance == 100000
        && request.resource.data.consecutive_losses == 0
        && request.resource.data.buy_locked_until == null
        && request.resource.data.created_at == request.time
        && request.resource.data.org_id == null
        && request.resource.data.referral_code == null
        && request.resource.data.referred_by == null
        && request.resource.data.pro_days_earned == 0
        && request.resource.data.pro_access_until == null;
      allow update: if isOwner(userId) && isValidAccountUpdate();
      allow delete: if false;

      match /portfolio/{coinSymbol} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPosition();
        allow delete: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOrder();
        // Order history is an append-only ledger.
        allow update, delete: if false;

        // Trade Rationale (Phase 8 Part C) — a retrospective-only note on
        // one already-closed trade. Deliberately write:false: the
        // "must be a closed SELL, timestamped after the order closed,
        // filtered for banned/forward-looking language" checks are all
        // enforced by the addTradeRationale callable
        // (functions/src/rationale/addTradeRationale.ts), not rules —
        // same reasoning as sendChatMessage.ts's callable-only design.
        // Readable by visitors only through the same public-profile gate
        // as everything else here, since a rationale is displayed on
        // trader_profile_screen.dart.
        match /rationale/{noteId} {
          allow read: if isOwner(userId) || isProfilePublic(userId);
          allow write: if false;
        }
      }

      // Micro-certifications (Phase 7 Part B). Only awarded by
      // evaluateTradeMilestones.ts / evaluateBacktestMilestones.ts
      // (Admin SDK, bypasses rules) — never client-writable, so a user
      // can't self-award a milestone they haven't reached.
      match /certifications/{certId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ------------------------------------------------------------------
      // Trader Profiles (Phase 8) — opt-in public performance profiles.
      // Split into two docs rather than fields on users/{userId} itself:
      // profile_settings is the small, fully client-writable "what do I
      // want visible" toggle; profile_stats is entirely
      // Cloud-Function-written derived data. Keeping them separate means
      // the write rule for each is a single unconditional allow/deny
      // rather than a growing list of per-field forgery guards.
      // ------------------------------------------------------------------

      match /profile_settings/data {
        allow read: if isOwner(userId) || isProfilePublic(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.display_name is string
          && request.resource.data.display_name.size() > 0
          && request.resource.data.display_name.size() <= 30
          && request.resource.data.is_public is bool;
        allow delete: if isOwner(userId);
      }

      // accuracy_pct, win_rate_pct, discipline_score, total_trades,
      // follower_count, following_count, etc. — all written only by
      // functions/src/traderProfile/*.ts (recomputeTraderStats.ts,
      // syncProfileVisibility.ts, onFollowChange.ts). A client could
      // otherwise simply write a perfect discipline_score directly;
      // "never trust client-submitted stats" is the whole point of this
      // feature being auditable.
      match /profile_stats/data {
        allow read: if isOwner(userId) || isProfilePublic(userId);
        allow write: if false;
      }

      // Small, factual, Cloud-Function-written activity log that powers
      // following_feed_screen.dart without needing to grant followers
      // read access into a stranger's actual orders/certifications/
      // rationale collections — see functions/src/traderProfile/
      // publicActivity.ts. Never a free-text field: every entry is one of
      // a fixed set of factual event shapes written server-side.
      match /public_activity/{activityId} {
        allow read: if isOwner(userId) || isProfilePublic(userId);
        allow write: if false;
      }

      // Follow relationships. A user's own follow list is private (who
      // you follow isn't inherently public just because your profile
      // is) — only follower_count/following_count (in profile_stats,
      // above) are shown publicly. followedUserId != userId stops a
      // self-follow from inflating counts.
      match /following/{followedUserId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && followedUserId != userId
          && request.resource.data.created_at == request.time;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Coin watchlist — pure personal preference (which curated coins
      // someone follows on the Markets screen), no server-computed
      // aggregate involved, so unlike `following` this is safe as a plain
      // owner-read/owner-write collection with no Cloud Function required.
      match /watchlist/{symbol} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.added_at == request.time
          && request.resource.data.sort_order is int;
        // Reordering (drag-and-drop on the Markets screen) only ever
        // touches sort_order — added_at is immutable once set.
        allow update: if isOwner(userId)
          && request.resource.data.added_at == resource.data.added_at
          && request.resource.data.sort_order is int;
        allow delete: if isOwner(userId);
      }

      // Price alerts. Lifecycle fields (is_active, triggered_at) are only
      // ever flipped by the checkPriceAlerts scheduled Cloud Function
      // (Admin SDK, bypasses these rules) — a client can create a fresh
      // alert or edit its target while it's still pending, but can't fake
      // a trigger or resurrect a fired one back to active.
      match /alerts/{alertId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.coin_symbol is string
          && request.resource.data.target_price is number
          && request.resource.data.target_price > 0
          && request.resource.data.direction in ['above', 'below']
          && request.resource.data.is_active == true
          && request.resource.data.triggered_at == null
          && request.resource.data.created_at == request.time;
        allow update: if isOwner(userId)
          && request.resource.data.coin_symbol is string
          && request.resource.data.target_price is number
          && request.resource.data.target_price > 0
          && request.resource.data.direction in ['above', 'below']
          && request.resource.data.is_active == resource.data.is_active
          && request.resource.data.triggered_at == resource.data.triggered_at
          && request.resource.data.created_at == resource.data.created_at;
        allow delete: if isOwner(userId);
      }

      // One doc per device token — see notifications_service.dart. Doc id
      // is the token itself, so re-registering the same device is a
      // no-op create/overwrite rather than accumulating duplicates. Only
      // the checkPriceAlerts function ever reads these (Admin SDK), so no
      // read rule is needed beyond the owner writing their own.
      match /fcm_tokens/{token} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && request.resource.data.updated_at == request.time;
      }
    }

    // ------------------------------------------------------------------
    // Community chat (Part A)
    // ------------------------------------------------------------------

    match /chat_rooms/{roomId} {
      // Room metadata (name, skill_level, member_count) isn't sensitive —
      // any signed-in user can see which rooms exist.
      allow read: if isSignedIn();
      // Rooms are provisioned once via functions/src/scripts/seedChatRooms.ts
      // (run by a developer with the Admin SDK), never by end users or the
      // app itself.
      allow write: if false;

      match /messages/{messageId} {
        // Only messages in the room matching the reader's own (server-
        // cached, unforgeable) skill level are readable — this is the
        // literal "users can only read rooms matching their skill_level"
        // requirement, enforced here rather than on the room doc itself
        // since the room doc's own fields (name, skill_level) are safe to
        // browse but its *contents* are the skill-appropriate part.
        allow read: if isSignedIn()
          && callerSkillLevel() == get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.skill_level;
        // All writes go through the sendChatMessage callable (Admin SDK),
        // which does the rate limiting, profanity filtering, and
        // skill-level check that can't be done safely/atomically in rules
        // alone — see the long comment in sendChatMessage.ts for why.
        allow write: if false;
      }
    }

    // Per-user rate-limit/moderation state. Clients can read their own (so
    // the app can show "you're temporarily restricted"), but never write —
    // last_message_at and flagged are both only ever set by Cloud
    // Functions (sendChatMessage.ts's transaction and
    // rateLimitTrigger.ts respectively).
    match /chat_rate_limits/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // User-submitted reports for manual moderator review — no automated
    // action taken on these beyond storing them (see community_chat_screen
    // .dart's report button). Write-only from the client's perspective:
    // nobody should be able to read the reports queue except via the
    // Firebase console / a future admin tool with its own auth model.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reported_by == request.auth.uid
        && request.resource.data.room_id is string
        && request.resource.data.message_id is string
        && request.resource.data.reason is string
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }

    // Settings > "Report a translation issue" (i18n Part D) — write-only
    // from the client, same shape as /reports above. Reviewed manually
    // against docs/translation_glossary.md, never read back in-app.
    match /translation_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reported_by == request.auth.uid
        && request.resource.data.language_code is string
        && request.resource.data.arb_key is string
        && request.resource.data.suggestion is string
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Daily puzzle (Part C)
    // ------------------------------------------------------------------

    match /daily_puzzle/{date} {
      // No login required to play — the puzzle itself (shown candles,
      // running aggregate stats) is fully public.
      allow read: if true;
      allow write: if false; // generateDailyPuzzle.ts / submitPuzzleAnswer.ts only

      match /secret/{document=**} {
        // The actual answer. Never client-readable at all — see the
        // comment in generateDailyPuzzle.ts for why this is split out of
        // the public doc instead of a single flatter document.
        allow read, write: if false;
      }
    }

    // ------------------------------------------------------------------
    // Public aggregate docs (Parts A, D, E) — anonymous counts/medians
    // only, Cloud-Function-written, never per-user data. See the path-
    // naming note in functions/src/sentiment/aggregateSentiment.ts for why
    // these are flat top-level collections rather than nested under a
    // shared "public" document.
    // ------------------------------------------------------------------

    match /public_sentiment/{symbol} {
      allow read: if true;
      allow write: if false;
    }

    match /public_market_weather/{document} {
      allow read: if true; // polled by the home-screen widget without auth
      allow write: if false;
    }

    match /public_cohort_medians/{cohortKey} {
      allow read: if isSignedIn(); // only meaningful to a signed-in trader
      allow write: if false;
    }

    // PII-free mirror of an earned certification, keyed by its
    // verification_code — see functions/src/lib/certifications.ts. Public
    // and unauthenticated on purpose: this is what lets docs/verify.html
    // (or a B2B academy) confirm a code is genuine without needing any
    // access into the earning user's own data.
    match /public_certifications/{verificationCode} {
      allow read: if true;
      allow write: if false;
    }

    // Top 100 by window, written only by
    // functions/src/traderProfile/computeLeaderboard.ts. A single small
    // doc per window rather than a live query over all profile_stats
    // docs — see that file for the compute-side reasoning.
    match /public_leaderboard/{window} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // B2B academy licensing (Growth phase Part A). Orgs are provisioned
    // manually by a developer via the Admin SDK — same as chat_rooms
    // above, this is a sales-negotiated relationship, not something an
    // end user can create through the app. Everything under an org is
    // Cloud-Function-written (functions/src/growth/orgs.ts) so seat counts
    // stay atomic and a client can't forge membership or admin status.
    // ------------------------------------------------------------------

    match /organizations/{orgId} {
      // Readable only by that org's own admins (checked as a plain field
      // membership test against the doc a query would return — Firestore
      // rules evaluate this per-candidate-document for a query the same
      // way as a direct get()). Students never read the org doc itself;
      // all they have is their own users/{uid}.org_id.
      allow read: if isSignedIn() && request.auth.uid in resource.data.admin_user_ids;
      allow write: if false;

      // Username + joined date only — see redeemOrgInviteCode.ts for why
      // this is a dedicated doc written at redemption time rather than a
      // query over `users` filtered by org_id: it lets the admin dashboard
      // show exactly "who's enrolled" without ever needing read access
      // into a student's actual account/orders/trade history, respecting
      // the "no individual trade data exposed to the org" requirement.
      match /members/{memberId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.admin_user_ids;
        allow write: if false;
      }

      // Anonymous, org-wide average (e.g. avg discipline score) computed
      // daily by functions/src/growth/computeOrgAggregateStats.ts —
      // deliberately never a per-student breakdown, so an academy can show
      // outcomes without any individual student's stats being exposed,
      // regardless of that student's own public/private profile choice.
      match /aggregate_stats/data {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.admin_user_ids;
        allow write: if false;
      }
    }

    // Invite-code lookup, keyed by the code itself for O(1) redemption —
    // never client-readable; redeemOrgInviteCode.ts (Admin SDK) is the
    // only thing that ever looks one up, and createOrgInviteCode.ts is the
    // only thing that ever creates one. An admin sees a freshly-created
    // code directly in that callable's response, not via a Firestore read.
    match /org_invite_codes/{code} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Referral program (Growth phase Part B) — non-monetary (Pro-access
    // days only, never cash/tradeable value). generateReferralCode.ts /
    // redeemReferralCode.ts (both Admin SDK) own every write here.
    // ------------------------------------------------------------------

    // Lookup collection, same reasoning as org_invite_codes above — a
    // client redeeming a code never reads this directly, the callable
    // does the code->uid resolution server-side.
    match /referral_codes/{code} {
      allow read, write: if false;
    }

    // Audit log powering referral_screen.dart's "N successful referrals"
    // count (a client-side `.where('referrer_id', '==', myUid)` query) —
    // readable only by the referrer it's about, never the referred user's
    // side of the record and never anyone else's.
    match /referrals/{referralId} {
      allow read: if isSignedIn() && resource.data.referrer_id == request.auth.uid;
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // News feed (provider-based aggregation) — written only by
    // functions/src/news/aggregateNews.ts on a schedule. Headlines and
    // short truncated summaries only, never full article text (enforced
    // server-side, see newsItems.ts) — public, non-personalized
    // content, so no auth is required to read it, matching
    // public_sentiment/public_market_weather above.
    //
    // news_pipeline_status is purely an internal operational doc
    // (consecutive-failure tracking for aggregateNews.ts's log-based
    // alert, see docs/RELEASE.md) — never read by the client, never
    // meant to be.
    // ------------------------------------------------------------------

    match /news_items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /news_pipeline_status/{document} {
      allow read, write: if false;
    }
  }
}
